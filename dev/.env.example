# Copy to .env (gitignored). Stand values only — never a prod secret, never in chat.
#   cp .env.example .env && python scripts/gen-secrets.py   # or fill by hand
# Prod (P2) reads the same names from a root-owned 600 env-file on the IdP host, not Vault
# (ADR 017 п. 12 — Vault unseal is manual, secrets there would deadlock a cold start).

KEYCLOAK_HTTP_PORT=8543

POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change-me-strong

# Bootstrap admin of the Keycloak master realm — the break-glass account of the IdP itself.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-strong

# WebAuthn Relying Party ID. Stand: localhost. Prod: qa.guru — the common parent, so a passkey
# survives moving the IdP host (ADR 017 п. 8). Never auth.qa.guru.
KC_WEBAUTHN_RP_ID=localhost

# GitHub brokering — YOUR OWN test OAuth App, not the school one.
# https://github.com/settings/developers → New OAuth App
#   Homepage URL:               http://localhost:8543
#   Authorization callback URL: http://localhost:8543/realms/qaguru/broker/github/endpoint
KC_GITHUB_CLIENT_ID=
KC_GITHUB_CLIENT_SECRET=

# Client stubs from the closed service × protocol matrix. Stand values; prod secrets are
# generated on the VM in P2 and never travel through git.
KC_CLIENT_SECRET_GRAFANA=change-me-stand-only
KC_CLIENT_SECRET_JENKINS=change-me-stand-only
KC_CLIENT_SECRET_GITLAB=change-me-stand-only
KC_CLIENT_SECRET_TESTOPS=change-me-stand-only
KC_CLIENT_SECRET_OAUTH2_PROXY=change-me-stand-only
KC_CLIENT_SECRET_LEARN=change-me-stand-only
KC_CLIENT_SECRET_AUTOTESTS_AI=change-me-stand-only
KC_CLIENT_SECRET_PROVISIONING=change-me-stand-only
KC_CLIENT_SECRET_SELENOID_TOKEN=change-me-stand-only

# P9 learn.qa.guru smoke RS (BFF stub on :3040). Not the LMS product.
LEARN_STUB_PORT=3040
LEARN_BREAKGLASS_USERNAME=admin
LEARN_BREAKGLASS_PASSWORD=change-me-stand-only
LEARN_SESSION_SECRET=change-me-stand-only

# Demo people for the stand only — created by scripts/seed-stand-users.sh, never in the realm file.
STAND_USER_PASSWORD=change-me-stand-only

# SMTP. Stand defaults to Mailpit in this compose (no auth). Prod: real relay in
# ~/.config/auth-qa-guru/keycloak.env mode 600 — never git, never Vault (ADR 017 §12).
# Reset is by username; do not turn on loginWithEmailAllowed (183 email collisions).
KC_SMTP_HOST=mailpit
KC_SMTP_PORT=1025
KC_SMTP_FROM=keycloak@localhost
KC_SMTP_FROM_DISPLAY="QA Guru"
KC_SMTP_SSL=false
KC_SMTP_STARTTLS=false
KC_SMTP_AUTH=false
KC_SMTP_USER=
KC_SMTP_PASSWORD=
MAILPIT_UI_PORT=8025
