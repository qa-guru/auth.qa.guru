# Off-box receiver for the daily Keycloak dump. Lives at /etc/keycloak/s3.env,
# root 600, never in git. Written by deploy/offbox.py provision --apply, which
# also creates the bucket and the retention rule — prefer that over hand-editing.
#
# Selectel Object Storage, path-style on the pool endpoint. The writer is a
# dedicated service user with role s3.admin scoped to a single project, so a
# leaked key reaches these buckets and nothing else in the account.
#
# The 2026-07 Hetzner keys that this file used to point at are revoked
# (InvalidAccessKeyId) — do not resurrect them.
S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
S3_REGION=ru-1
S3_BUCKET=qa-guru-idp-backup
S3_PREFIX=auth-qa-guru/
S3_ACCESS_KEY=
S3_SECRET_KEY=
