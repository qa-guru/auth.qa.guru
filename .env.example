# Names only. Prod secrets live in ~/.config/auth-qa-guru/keycloak.env (laptop)
# and /etc/keycloak/keycloak.env on the host (root, mode 600). Never git, never Vault
# (ADR 017 §12 — Vault unseal is manual, secrets there would deadlock a cold start).
#
#   ./deploy/init-env.sh

POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Common parent so a passkey survives moving the IdP host. Never auth.qa.guru.
KC_WEBAUTHN_RP_ID=qa.guru
KC_HOSTNAME=https://auth.qa.guru

# GitHub brokering — school OAuth App in P5, not this window.
KC_GITHUB_CLIENT_ID=github-oauth-app-not-configured
KC_GITHUB_CLIENT_SECRET=github-oauth-app-not-configured

KC_CLIENT_SECRET_GRAFANA=
KC_CLIENT_SECRET_JENKINS=
KC_CLIENT_SECRET_GITLAB=
KC_CLIENT_SECRET_TESTOPS=
KC_CLIENT_SECRET_PROVISIONING=
